# === Anthropic / Claude ===
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# === LLM backend ===
# 'api'         -> direct Anthropic Messages API (plain chat, needs ANTHROPIC_API_KEY)
# 'claude_code' -> native Claude Code CLI (agentic: can read/edit files & run
#                  commands in CLAUDE_CODE_WORKDIR). Requires the 'claude' CLI:
#                  npm install -g @anthropic-ai/claude-code
LLM_BACKEND=api

# === Claude Code CLI backend (only used when LLM_BACKEND=claude_code) ===
# Directory Claude Code operates in. Empty = server's current working dir.
CLAUDE_CODE_WORKDIR=
# default | acceptEdits | bypassPermissions
CLAUDE_CODE_PERMISSION_MODE=default
# Comma-separated allowed tools, e.g. Read,Grep,Edit,Bash. Empty = CLI default.
CLAUDE_CODE_ALLOWED_TOOLS=
CLAUDE_CODE_MAX_TURNS=12

# === Whisper STT ===
# Model options: tiny, base, small, medium, large-v3, distil-large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# === Audio ===
SAMPLE_RATE=16000

# === VAD ===
# 0 = least aggressive, 3 = most aggressive
VAD_MODE=2
MAX_SILENCE_MS=700
MIN_SPEECH_MS=300

# === Transcription ===
PARTIAL_UPDATE_MS=250

# === Voice → Claude Code terminal (browser-free runner) ===
# Substring of the terminal window title running Claude Code. The transcript is
# pasted there + Enter. Empty = type into whatever window is focused.
#   Tips: Windows Terminal titles often contain the running command or folder.
#   You can also rename a tab so it contains e.g. "claude".
CC_WINDOW_TITLE=
# If the target window isn't focused, find it by title and focus it first.
CC_AUTO_FOCUS=true
# Press Enter after pasting to submit the prompt.
CC_INJECT_PRESS_ENTER=true

# === Universal push-to-talk dictation ===
# Hold this hotkey anywhere in Windows, speak, release -> the transcribed text
# is typed at the current cursor (Word, Chrome, terminal, any text field).
# NOTE: the laptop 'Fn' key can't be used as a hotkey — it's handled in the
# keyboard's firmware and never reaches the OS, so software can't detect it.
# 'ctrl+shift+space' avoids Windows' own shortcuts (e.g. Win+H dictation).
PTT_HOTKEY=ctrl+shift+space
# How text is emitted:
#   'type'  -> Unicode keystrokes (clipboard-safe, works everywhere)
#   'paste' -> clipboard + Ctrl+V (faster for long dictations)
PTT_OUTPUT_MODE=type
# Ignore clips shorter than this many seconds (accidental taps).
PTT_MIN_RECORD_S=0.3
# Append a trailing space after each dictation.
PTT_APPEND_SPACE=true
